cmake_minimum_required(VERSION 3.16)

project(ModuleSingle CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set(SystemCLanguage_DIR
    "{YOUR_SYSTEMC_PATH}/build"
    CACHE PATH "SystemC CMake package directory"
)

find_package(SystemCLanguage CONFIG REQUIRED)

add_executable(ModuleSingle
    main.cpp
)

target_link_libraries(ModuleSingle
    SystemC::systemc
)