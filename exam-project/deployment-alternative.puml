@startuml deployment
skinparam linetype ortho
skinparam Nodesep 120
skinparam Ranksep 20


node ZYBO <<device>> {
    
    node FPGA <<processor>> {

    }

    node ARM <<processor>> {
        card UART <<component>>
        card Decoder <<component>>
        card Filter <<component>>
        card MapReducer <<component>>
        card ResultSelector <<component>>
        card ResultReporter <<component>>
        card ErrorReporter <<component>>
    }


    UART -[hidden]down- Decoder
    Decoder -[hidden]down- Filter
    Filter -[hidden]down- MapReducer
    MapReducer -[hidden]down- ResultSelector
    ResultSelector -[hidden]down- ResultReporter
    ResultReporter -[hidden]down- ErrorReporter



    FPGA -right- ARM : Memory\n bus
}

node PC <<device>>

ZYBO -right- PC : Serial\nUSB

@enduml