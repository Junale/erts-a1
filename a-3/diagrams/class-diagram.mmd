classDiagram
    direction TB

    class User
    User "1" --> "1" EmbeddedSystemX : triggers events

    %% ---------- Context ----------
    class EmbeddedSystemX {
        -versionNo : int
        -name : char#42;
        -errorNo : int
        -currentState : State#42;
        -rtl : RealTimeLoop#42;
        +EmbeddedSystemX()
        +selftestOk() void
        +selfTestFailed(errorNo : int) void
        +initialized() void
        +restart() void
        +configure() void
        +configurationEnded() void
        +configX() void
        +start() void
        +stop() void
        +exit() void
        +chMode1() void
        +chMode2() void
        +eventX() void
        +eventY() void
        +printState() void
        ~changeState(next : State&) void
        ~getRealTimeLoop() RealTimeLoop#42;
    }

    %% ---------- State pattern ----------
    class State {
        <<abstract>>
        +selftestOk(ctx : EmbeddedSystemX&) void
        +selfTestFailed(ctx : EmbeddedSystemX&, errorNo : int) void
        +initialized(ctx : EmbeddedSystemX&) void
        +restart(ctx : EmbeddedSystemX&) void
        +configure(ctx : EmbeddedSystemX&) void
        +configurationEnded(ctx : EmbeddedSystemX&) void
        +configX(ctx : EmbeddedSystemX&) void
        +start(ctx : EmbeddedSystemX&) void
        +stop(ctx : EmbeddedSystemX&) void
        +exit(ctx : EmbeddedSystemX&) void
        +chMode1(ctx : EmbeddedSystemX&) void
        +chMode2(ctx : EmbeddedSystemX&) void
        +eventX(ctx : EmbeddedSystemX&) void
        +eventY(ctx : EmbeddedSystemX&) void
        +entry(ctx : EmbeddedSystemX&) void
        +exitAction(ctx : EmbeddedSystemX&) void
        +name()* const char#42;
    }

    class PowerOnSelfTest {
        <<singleton>>
        -PowerOnSelfTest()
        +instance()$ PowerOnSelfTest&
        +entry(ctx) void  // systemSelftest
        +selftestOk(ctx) void
        +selfTestFailed(ctx, errorNo) void
        +name() const char#42;
    }

    class Initializing {
        <<singleton>>
        -Initializing()
        +instance()$ Initializing&
        +entry(ctx) void  // startInitializing
        +initialized(ctx) void
        +name() const char#42;
    }

    class Failure {
        <<singleton>>
        -Failure()
        +instance()$ Failure&
        +entry(ctx) void  // display(errorNo)
        +restart(ctx) void
        +exit(ctx) void
        +name() const char#42;
    }

    class Operational {
        <<abstract>>
        +restart(ctx) void
    }

    class Ready {
        <<singleton>>
        -Ready()
        +instance()$ Ready&
        +configure(ctx) void
        +start(ctx) void
        +name() const char#42;
    }

    class Configuration {
        <<singleton>>
        -Configuration()
        +instance()$ Configuration&
        +entry(ctx) void  // readConfigurationInfo
        +configX(ctx) void  // PerformConfigurationX
        +configurationEnded(ctx) void
        +name() const char#42;
    }

    class RealTimeLoopState {
        <<singleton>>
        -RealTimeLoopState()
        +instance()$ RealTimeLoopState&
        +entry(ctx) void  // start active object
        +exitAction(ctx) void  // stop active object
        +stop(ctx) void
        +chMode1(ctx) void  // forwards to RealTimeLoop
        +chMode2(ctx) void  // forwards to RealTimeLoop
        +eventX(ctx) void
        +eventY(ctx) void
        +name() const char#42;
    }

    EmbeddedSystemX o--> "1" State : currentState
    State <|-- PowerOnSelfTest
    State <|-- Initializing
    State <|-- Failure
    State <|-- Operational
    Operational <|-- Ready
    Operational <|-- Configuration
    Operational <|-- RealTimeLoopState

    %% ---------- Active object: RealTimeLoop ----------
    class RealTimeLoop {
        <<active object>>
        -queue : ActivationQueue
        -currentMode : ModeState#42;
        -worker : std::thread
        -running : bool
        +RealTimeLoop()
        +~RealTimeLoop()
        +startThread() void
        +stopThread() void
        +chMode1() void  // enqueue ChMode1Request
        +chMode2() void  // enqueue ChMode2Request
        +eventX() void
        +eventY() void
        ~changeMode(next : ModeState&) void
        ~getMode() ModeState#42;
        -run() void  // dispatch loop
    }

    class ActivationQueue {
        -requests : std::queue~Request*~
        -mtx : std::mutex
        -cv : std::condition_variable
        +push(r : Request*) void
        +pop() Request#42;
    }

    class Request {
        <<abstract>>
        #rtl : RealTimeLoop&
        +execute()* void
    }

    class ChMode1Request {
        +execute() void  // rtl.getMode()->chMode1(rtl)
    }

    class ChMode2Request {
        +execute() void  // rtl.getMode()->chMode2(rtl)
    }

    class EventXRequest {
        +execute() void  // rtl.getMode()->eventX(rtl)
    }

    class ModeState {
        <<abstract>>
        +chMode1(rtl : RealTimeLoop&) void
        +chMode2(rtl : RealTimeLoop&) void
        +eventX(rtl : RealTimeLoop&) void
        +eventY(rtl : RealTimeLoop&) void
        +name()* const char#42;
    }

    class Mode1 {
        <<singleton>>
        -Mode1()
        +instance()$ Mode1&
        +chMode2(rtl) void
        +eventX(rtl) void  // responseM1eventX
        +name() const char#42;
    }

    class Mode2 {
        <<singleton>>
        -Mode2()
        +instance()$ Mode2&
        +chMode1(rtl) void
        +eventX(rtl) void  // responseM2eventX
        +name() const char#42;
    }

    EmbeddedSystemX *--> "1" RealTimeLoop : rtl
    RealTimeLoopState ..> RealTimeLoop : forwards chMode/events
    RealTimeLoop *--> "1" ActivationQueue
    ActivationQueue o--> "0..*" Request
    Request <|-- ChMode1Request
    Request <|-- ChMode2Request
    Request <|-- EventXRequest
    Request --> RealTimeLoop : rtl
    RealTimeLoop o--> "1" ModeState : currentMode
    ModeState <|-- Mode1
    ModeState <|-- Mode2
